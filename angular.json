{
  "$schema": "https://schematics.angular.io/schemas/collection-schema.json",
  "version": 1,
  "projects": {
    "rrhh-front": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/rrhh-front",
            "browser": "src/main.ts",
            "styles": [
              "src/styles.scss"
            ],
            "assets": [
              "public"
            ]
          },
          "configurations": {
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "production": {
              "optimization": true,
              "extractLicenses": true,
              "sourceMap": false
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json",
            "buildTarget": "rrhh-front:build:development"
          }
        }
      }
    }
  }
}
