{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "defaultProject": "rrhh-front",
  "projects": {
    "rrhh-front": {
      "projectType": "application",
      "root": "src",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/rrhh-front",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": [],
            "assets": [
              "public"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "tsConfig": "tsconfig.app.json"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "browserTarget": "rrhh-front:build",
            "proxyConfig": "proxy.conf.json"
          }
        }
      }
    }
  }
}
