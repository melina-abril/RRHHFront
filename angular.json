{
  "version": 1,
  "projects": {
    "rrhh-front": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/rrhh-front",
            "index": "src/index.html",
            "polyfills": [],
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": [
              "src/styles.scss"
            ],
            "browser": "src/main.ts"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json",
            "buildTarget": "rrhh-front:build"
          }
        },
        "watch": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/rrhh-front",
            "index": "src/index.html",
            "polyfills": [],
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": [
              "src/styles.scss"
            ],
            "watch": true,
            "browser": "src/main.ts"
          }
        }
      }
    }
  }
}
