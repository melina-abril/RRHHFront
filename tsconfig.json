{
  "compilerOptions": {
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "experimentalDecorators": true,
    "skipLibCheck": true
  },
  "exclude": ["dist", "node_modules"]
}
